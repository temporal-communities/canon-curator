{
    "@version": 1.1,

    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "rdf":  "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "xsd":  "http://www.w3.org/2001/XMLSchema#",
    "schema": "http://schema.org/",
    "prov": "http://www.w3.org/ns/prov#",
    "lrm":  "http://iflastandards.info/ns/lrm/lrmoo/",
    "homoit": "https://homosaurus.org/v4/",
    "canon": "https://github.com/temporal-communities/canon-curator/",

    "Work": "canon:Work",
    "CanonList": "canon:CanonList",
    "EnrichmentRecord": "canon:EnrichmentRecord",
    "Author": "canon:Author",

    "hasEnrichment": { "@id": "canon:hasEnrichment", "@type": "@id" },
    "geolocation":   { "@id": "canon:geolocation",   "@type": "@id" },
    "authorGeolocation": { "@id": "canon:authorGeolocation", "@type": "@id" },
    "authorBirthPlace":  { "@id": "canon:authorBirthPlace",  "@type": "@id" },
    "workGeolocation":   { "@id": "canon:workGeolocation",   "@type": "@id" },
    "workOrigin":        { "@id": "canon:workOrigin",        "@type": "@id" },
    "languageGeolocation": { "@id": "canon:languageGeolocation", "@type": "@id" },
    "authorLanguage":    { "@id": "canon:authorLanguage", "@type": "@id" },
    "workLanguage":      { "@id": "canon:workLanguage",  "@type": "@id" },
    "assumedGeolocation":{ "@id": "canon:assumedGeolocation", "@type": "@id" },
    "gender":            { "@id": "canon:gender", "@type": "@id" },
    "assumedGender":     { "@id": "canon:assumedGender", "@type": "@id" },
    "recordedGender":    { "@id": "canon:recordedGender", "@type": "@id" },
    "selfIdentifiedGender": { "@id": "canon:selfIdentifiedGender", "@type": "@id" }
}