# CANON ONTOLOGY
# Version 1.0 (Beta)
# 06.11.2025
# Please note that this is a beta version intended for testing. 
# The ontology namespace and URI are meant as placeholders. 

@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix dct:     <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix place:   <http://www.ontologydesignpatterns.org/cp/owl/place.owl#> .
@prefix geo:     <http://www.w3.org/2003/01/geo/wgs84_pos#> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix canon:   <https://github.com/temporal-communities/canon-curator/ontology/> .

<https://github.com/temporal-communities/canon-curator/ontology/> a owl:Ontology ;
    rdfs:label "Canon Ontology" .

### CLASSES

# Main classes

canon:CanonList a owl:Class ;
    rdfs:subClassOf dct:Collection ;
    rdfs:label "canon list"@en .

canon:Work a owl:Class ;
    rdfs:subClassOf dct:BibliographicResource ;
    rdfs:label "work"@en .

canon:Author a owl:Class ;
    rdfs:subClassOf dct:Agent ;
    rdfs:label "author"@en .

canon:EnrichmentRecord a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "enrichment record"@en .

canon:Location a owl:Class ;
    rdfs:subClassOf place:Place ;
    rdfs:label "location"@en .

# Activities

canon:EnrichmentActivity a owl:Class ;
    rdfs:subClassOf prov:Activity ;
    rdfs:label "enrichment activity"@en .

canon:EntityReconciliation a owl:Class ;
    rdfs:subClassOf canon:EnrichmentActivity ;
    rdfs:label "entity reconciliation"@en .

canon:MetadataEnrichment a owl:Class ;
    rdfs:subClassOf canon:EnrichmentActivity ;
    rdfs:label "metadata enrichment"@en .


### PROPERTIES

# Object Properties

canon:hasEnrichment a owl:ObjectProperty ;
    rdfs:label "has enrichment"@en ;
    rdfs:range canon:EnrichmentRecord .

canon:hasMetadata a owl:ObjectProperty ;
    rdfs:label "has metadata record"@en ;
    rdfs:domain canon:CanonList .

canon:geolocation a owl:ObjectProperty ;
    rdfs:label "geolocation"@en ;
    rdfs:subPropertyOf place:hasLocation ;
    rdfs:range canon:Location .

canon:authorBirthPlace a owl:ObjectProperty ;
    rdfs:label "place of birth"@en ;
    rdfs:subPropertyOf canon:geolocation ;
    rdfs:domain canon:Author ;
    rdfs:comment "E.g. Wikidata P19" .

canon:workOrigin a owl:ObjectProperty ;
    rdfs:label "place of origin"@en ;
    rdfs:subPropertyOf canon:geolocation ;
    rdfs:domain canon:Work ;
    rdfs:comment "E.g. Wikidata P495" .

canon:assumedGeolocation a owl:ObjectProperty ;
    rdfs:label "assumed geolocation"@en ;
    rdfs:subProprtyOf canon:geolocation .

canon:gender a owl:ObjectProperty ;
    rdfs:label "gender"@en ;
    rdfs:domain canon:Author .

canon:assumedGender a owl:ObjectProperty ;
    rdfs:label "assumed gender"@en ;
    rdfs:subPropertyOf canon:gender .

canon:recordedGender a owl:ObjectProperty ;
    rdfs:label "recorded gender"@en ;
    rdfs:subPropertyOf canon:gender .

canon:selfIdentifiedGender a owl:ObjectProperty ;
    rdfs:label "self-identified gender"@en ;
    rdfs:subPropertyOf canon:gender .

# Data Properties

canon:canonicityMetric a owl:DatatypeProperty ;
    rdfs:label "canonicity metric"@en ;
    rdfs:domain canon:Work .

canon:qRank a owl:DatatypeProperty ;
    rdfs:label "QRank rank"@en ;
    rdfs:subPropertyOf canon:canonicityMetric ;
    rdfs:range xsd:integer .

canon:sitelinkCount a owl:DatatypeProperty ;
    rdfs:label "sitelink count"@en ;
    rdfs:subPropertyOf canon:canonicityMetric ;
    rdfs:range xsd:integer .

canon:ratingValue a owl:DatatypeProperty ;
    rdfs:label "rating value"@en ;
    rdfs:subPropertyOf canon:canonicityMetric ;
    rdfs:range xsd:decimal .

canon:ratingCount a owl:DatatypeProperty ;
    rdfs:label "rating count"@en ;
    rdfs:subPropertyOf canon:canonicityMetric ;
    rdfs:range xsd:integer .

