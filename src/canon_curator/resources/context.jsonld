{
  "@context": {
    "@version": 1.1,

    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "dct": "http://purl.org/dc/terms/",
    "place": "http://www.ontologydesignpatterns.org/cp/owl/place.owl#",
    "geo": "http://www.w3.org/2003/01/geo/wgs84_pos#",
    "prov": "http://www.w3.org/ns/prov#",
    "pav": "http://purl.org/pav/",
    "owl": "http://www.w3.org/2002/07/owl#",

    "Ontology": "http://www.w3.org/2002/07/owl#Ontology",

    "CanonList": "https://github.com/temporal-communities/canon-curator/ontology/CanonList",
    "Work": "https://github.com/temporal-communities/canon-curator/ontology/Work",
    "Author": "https://github.com/temporal-communities/canon-curator/ontology/Author",
    "EnrichmentRecord": "https://github.com/temporal-communities/canon-curator/ontology/EnrichmentRecord",
    "Location": "https://github.com/temporal-communities/canon-curator/ontology/Location",
    "EnrichmentActivity": "https://github.com/temporal-communities/canon-curator/ontology/EnrichmentActivity",
    "EntityReconciliation": "https://github.com/temporal-communities/canon-curator/ontology/EntityReconciliation",
    "MetadataEnrichment": "https://github.com/temporal-communities/canon-curator/ontology/MetadataEnrichment",

    "label": {
      "@id": "http://www.w3.org/2000/01/rdf-schema#label"
    },
    "comment": {
      "@id": "http://www.w3.org/2000/01/rdf-schema#comment"
    },

    "title": {
      "@id": "http://purl.org/dc/terms/title"
    },
    "hasPart": {
      "@id": "http://purl.org/dc/terms/hasPart",
