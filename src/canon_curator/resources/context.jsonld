    },
    "generated": {
      "@id": "http://www.w3.org/ns/prov#generated",
      "@type": "@id"
    },
    "wasAssociatedWith": {
      "@id": "http://www.w3.org/ns/prov#wasAssociatedWith",
      "@type": "@id"
    },

    "sourceAccessedAt": {
      "@id": "http://purl.org/pav/sourceAccessedAt",
      "@type": "@id"
    },
    "retrievedOn": {
      "@id": "http://purl.org/pav/retrievedOn",
