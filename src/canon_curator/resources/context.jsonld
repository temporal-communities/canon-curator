    },
    "isPartOf": {
      "@id": "http://purl.org/dc/terms/isPartOf",
      "@type": "@id"
    },
    "creator": {
      "@id": "http://purl.org/dc/terms/creator",
      "@type": "@id"
    },
    "issued": {
      "@id": "http://purl.org/dc/terms/issued"
    },

    "hasEnrichment": {
      "@id": "https://github.com/temporal-communities/canon-curator/ontology/hasEnrichment",
      "@type": "@id"
    },
    "hasMetadata": {
      "@id": "https://github.com/temporal-communities/canon-curator/ontology/hasMetadata",
      "@type": "@id"
    },

    "geolocation": {
      "@id": "https://github.com/temporal-communities/canon-curator/ontology/geolocation",
      "@type": "@id"
    },
    "authorBirthPlace": {
      "@id": "https://github.com/temporal-communities/canon-curator/ontology/authorBirthPlace",
      "@type": "@id"
    },
    "workOrigin": {
      "@id": "https://github.com/temporal-communities/canon-curator/ontology/workOrigin",
      "@type": "@id"
    },
    "assumedGeolocation": {
      "@id": "https://github.com/temporal-communities/canon-curator/ontology/assumedGeolocation",
      "@type": "@id"
    },

    "gender": {
      "@id": "https://github.com/temporal-communities/canon-curator/ontology/gender",
      "@type": "@id"
    },
    "assumedGender": {
      "@id": "https://github.com/temporal-communities/canon-curator/ontology/assumedGender",
      "@type": "@id"
    },
    "recordedGender": {
      "@id": "https://github.com/temporal-communities/canon-curator/ontology/recordedGender",
      "@type": "@id"
    },
    "selfIdentifiedGender": {
      "@id": "https://github.com/temporal-communities/canon-curator/ontology/selfIdentifiedGender",
      "@type": "@id"
    },

    "popularityMetric": {
      "@id": "https://github.com/temporal-communities/canon-curator/ontology/popularityMetric",
